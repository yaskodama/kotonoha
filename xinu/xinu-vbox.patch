+	psd->sd_lolimit = 0xFFFF;
+	psd->sd_hilimit = 0xF;
 
 	psd = &gdt_copy[3];	/* kernel stack segment */
-	psd->sd_lolimit = npages;
-	psd->sd_hilimit = npages >> 16;
+	psd->sd_lolimit = 0xFFFF;
+	psd->sd_hilimit = 0xF;
 
 	psd = &gdt_copy[4];	/* bootp code segment */
 	psd->sd_lolimit = npages;   /* Allows execution of 0x100000 CODE */
